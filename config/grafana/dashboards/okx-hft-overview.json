        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {"selected": false, "text": "Loki", "value": "loki"},
        "hide": 0,
        "includeAll": false,
        "label": "Logs",
        "multi": false,
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "OKX HFT - Overview",
  "uid": "okx-hft-overview"
}
